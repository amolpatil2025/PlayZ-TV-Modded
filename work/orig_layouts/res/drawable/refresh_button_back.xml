<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/event_background" />
            <stroke android:width="1.0dip" android:color="@color/app_color" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/event_background" />
            <stroke android:width="1.0dip" android:color="@color/stroke_color" />
        </shape>
    </item>
</selector>
