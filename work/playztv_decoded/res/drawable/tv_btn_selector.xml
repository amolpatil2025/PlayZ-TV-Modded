<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/secondary_color" />
            <stroke android:width="1.0dip" android:color="@color/primary_color" />
            <corners android:radius="12.0dip" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/secondary_color" />
            <stroke android:width="1.0dip" android:color="@android:color/holo_red_dark" />
            <corners android:radius="12.0dip" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/event_background" />
            <stroke android:width="1.0dip" android:color="@color/primary_color" />
            <corners android:radius="12.0dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/event_background" />
            <stroke android:width="1.0dip" android:color="@color/stroke_color" />
            <corners android:radius="12.0dip" />
        </shape>
    </item>
</selector>
